{
  "name": "json-to-json",
  "request": {
    "model": "chat",
    "messages": [
      {
        "role": "user",
        "content": "Hello"
      }
    ],
    "stream": false,
    "store": true
  },
  "upstream": {
    "status": 200,
    "headers": {
      "content-type": [
        "application/json"
      ]
    },
    "body": {
      "id": "demo",
      "object": "chat.completion",
      "created": 1,
      "model": "demo-model",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "hello"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "total_tokens": 2
      }
    }
  },
  "expect": {
    "sent": true,
    "outbound": {
      "url": "https://example.invalid/v1/chat/completions",
      "headers": {
        "accept": [
          "application/json"
        ],
        "content-type": [
          "application/json"
        ],
        "x-policy": [
          "checked"
        ]
      },
      "body": {
        "model": "demo-model",
        "messages": [
          {
            "role": "user",
            "content": "Hello"
          }
        ],
        "stream": false
      }
    },
    "response": {
      "status": 200,
      "body": {
        "id": "demo",
        "object": "chat.completion",
        "created": 1,
        "model": "chat",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": "hello"
            },
            "finish_reason": "stop"
          }
        ],
        "usage": {
          "total_tokens": 2
        }
      }
    }
  }
}
