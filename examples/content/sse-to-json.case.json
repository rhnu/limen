{
  "name": "synthetic-text-sse-to-json",
  "request": {
    "model": "chat",
    "messages": [
      {
        "role": "user",
        "content": "Say hello"
      }
    ],
    "stream": false
  },
  "upstream": {
    "status": 200,
    "headers": {
      "content-type": [
        "text/event-stream"
      ]
    },
    "bodyFile": "synthetic-tool.sse"
  },
  "expect": {
    "sent": true,
    "response": {
      "status": 200,
      "body": {
        "id": "content-demo",
        "object": "chat.completion",
        "created": 1,
        "model": "chat",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": "Hello reader 😀\n"
            },
            "finish_reason": "stop"
          }
        ]
      }
    }
  }
}
