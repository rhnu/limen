{
  "name": "bounded-complete-part",
  "request": {
    "model": "complete",
    "messages": [
      {
        "role": "user",
        "content": "Say hello"
      }
    ],
    "stream": false
  },
  "upstream": {
    "status": 200,
    "headers": {
      "content-type": [
        "application/json"
      ]
    },
    "body": {
      "id": "content-demo",
      "object": "chat.completion",
      "created": 1,
      "model": "demo-model",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "Hello world"
          },
          "finish_reason": "stop"
        }
      ]
    }
  },
  "expect": {
    "sent": true,
    "response": {
      "status": 200,
      "body": {
        "id": "content-demo",
        "object": "chat.completion",
        "created": 1,
        "model": "complete",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": "Hello reader"
            },
            "finish_reason": "stop"
          }
        ]
      }
    }
  }
}
