{
  "name": "synthetic-text-json-to-sse",
  "request": {
    "model": "chat",
    "messages": [
      {
        "role": "user",
        "content": "Say hello"
      }
    ],
    "stream": true
  },
  "upstream": {
    "status": 200,
    "headers": {
      "content-type": [
        "application/json"
      ]
    },
    "body": {
      "id": "content-demo",
      "object": "chat.completion",
      "created": 1,
      "model": "demo-model",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "call_public",
                "type": "function",
                "function": {
                  "name": "limen_emit_text",
                  "arguments": "{\"text\":\"Hello world \\ud83d\\ude00\\n\"}"
                }
              }
            ]
          },
          "finish_reason": "tool_calls"
        }
      ]
    }
  },
  "expect": {
    "sent": true,
    "response": {
      "status": 200,
      "done": true,
      "events": [
        {
          "id": "content-demo",
          "object": "chat.completion.chunk",
          "created": 1,
          "model": "chat",
          "choices": [
            {
              "index": 0,
              "delta": {
                "role": "assistant"
              },
              "finish_reason": null
            }
          ]
        },
        {
          "id": "content-demo",
          "object": "chat.completion.chunk",
          "created": 1,
          "model": "chat",
          "choices": [
            {
              "index": 0,
              "delta": {
                "content": "Hello reader 😀\n"
              },
              "finish_reason": null
            }
          ]
        },
        {
          "id": "content-demo",
          "object": "chat.completion.chunk",
          "created": 1,
          "model": "chat",
          "choices": [
            {
              "index": 0,
              "delta": {},
              "finish_reason": "stop"
            }
          ]
        }
      ]
    }
  }
}
