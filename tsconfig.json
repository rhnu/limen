{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": []
  },
  "include": ["sdk/**/*.d.ts", "sdk/**/*.js", "examples/**/*.js", "examples/**/*.mjs"],
  "exclude": ["examples/libraries/**"]
}
