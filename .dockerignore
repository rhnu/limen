# Build inputs are an allowlist. Local configuration and credentials stay out of
# every stage and exported build cache, even when they are untracked by Git.
**
!Cargo.toml
!Cargo.lock
!LICENSE
!rust-toolchain.toml
!build.rs
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!patches/*.patch
!api/admin.openapi.json
!api/codegen/package.json
!api/codegen/openapi-ts.config.ts
!api/codegen/check.mjs
!web/package.json
!web/tsconfig.json
!web/vite.config.ts
!web/index.html
!web/public/favicon.svg
!web/src/**/*.ts
!web/src/**/*.tsx
!web/src/**/*.css
!src/**/*.rs
!modules/*/Cargo.toml
!modules/*/src/**/*.rs
!xtask/Cargo.toml
!xtask/src/**/*.rs
# These scripts are embedded with include_str!/include_bytes!, not deployment configuration.
!modules/script/src/**/*.js

# These remain excluded even if placed below an allowed source directory.
**/local
**/data
**/target
**/node_modules
**/dist
**/.git
**/.env
**/.env.*
**/secrets.*
**/*.pem
**/*.key
