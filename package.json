{
  "name": "limen-tools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api:generate": "pnpm --filter @limen/api-client generate",
    "api:check": "pnpm --filter @limen/api-client check",
    "build:scripts": "node modules/script/build.mjs",
    "build:examples": "node examples/libraries/build.mjs",
    "build:web": "pnpm --filter @limen/web build",
    "dev:web": "pnpm --filter @limen/web dev",
    "check:types": "tsc --project tsconfig.json && tsc --project modules/script/tsconfig.json && tsc --project examples/libraries/tsconfig.json && pnpm --filter @limen/web check:types",
    "lint:web": "pnpm --filter @limen/web lint",
    "format:web": "pnpm --filter @limen/web exec oxfmt --write --ignore-path .oxfmtignore .",
    "format:web:check": "pnpm --filter @limen/web format:check",
    "test:web": "pnpm --filter @limen/web test"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "valibot": "1.5.0"
  }
}
