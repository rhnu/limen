{
  "name": "@limen/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:types": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json --ignore-path .oxlintignore --max-warnings 0 src vite.config.ts",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore .",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "@tanstack/react-query": "5.104.3",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "valibot": "1.5.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
